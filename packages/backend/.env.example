# Riot Games API key used by the Crux backend to fetch summoner data.
# Get a development key from https://developer.riotgames.com/ (expires every 24h).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# OverFast community API URL for Overwatch 2 data (no auth key required).
# Default public instance: https://overfast-api.tekrop.fr
OVERWATCH_API_URL=https://overfast-api.tekrop.fr

# Port the backend server listens on (default: 3001)
PORT=3001
